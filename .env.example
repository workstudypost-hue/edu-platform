# ============ التطبيق ============
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ============ قاعدة البيانات ============
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edu_platform?schema=public"
# اختياري لاحقًا: نسخة القراءة فقط للتقارير
DATABASE_REPLICA_URL="postgresql://postgres:postgres@localhost:5433/edu_platform?schema=public"

# ============ Redis (جلسات، Rate limiting، BullMQ) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ JWT ============
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ============ OTP ============
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ============ OAuth ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/public/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/public/microsoft/callback

# ============ مزودو الإشعارات (Email/SMS) ============
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ============ Object Storage (S3/R2) ============
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_UPLOADS=raw-uploads
STORAGE_BUCKET_REPORTS=generated-reports

# ============ بوابات الدفع ============
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
TABBY_API_KEY=
TAMARA_API_TOKEN=

# ============ الذكاء الاصطناعي ============
ANTHROPIC_API_KEY=
